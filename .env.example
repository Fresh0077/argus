# ============================================================
# ARGUS 环境变量模板
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env        （PowerShell: Copy-Item .env.example .env）
#   2. 在 .env 中填写真实值     （.env 已被 .gitignore 忽略，不会被提交）
#   3. 本文件只保留占位符，任何情况下都不要在此填入真实密钥
#
# 安全约定：
#   - 真实 API key 只允许写入本地 .env，禁止写入源码、前端、文档、报告或 Git
#   - 前端不得读取以下任何变量；前端只能使用独立的 VITE_API_BASE_URL
# ============================================================

# ---------- 应用基础配置 ----------
# development | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 允许跨域访问的来源，多个用英文逗号分隔。
# 开发环境只允许 Vite 本地开发服务器；不要配置成 * 或任意来源。
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 扫描输入限制 ----------
# 单个上传文件大小上限（字节），默认 1 MB
MAX_UPLOAD_SIZE_BYTES=1048576
# 直接提交的代码文本长度上限（字符）
MAX_SOURCE_CODE_CHARS=200000
# 单个扫描请求的总超时（秒）
SCAN_TIMEOUT_SECONDS=60

# 允许上传的扩展名白名单，多个用英文逗号分隔。
# 判断文件类型只依据扩展名，不使用客户端提交的 MIME 类型。
# 带不带前导点都可以（".py" 与 "py" 等价），填写值会被统一转为小写。
# 注意：若扩充了此列表，请同步在 app/core/uploads.py 的
# EXTENSION_LANGUAGE_MAP 中登记新扩展名对应的语言，
# 否则该类型文件仍可上传，但响应中的 detected_language 会是 null。
ALLOWED_FILE_EXTENSIONS=py,js,jsx,ts,tsx,php,java,go,rb,html,vue

# ---------- LLM 分析服务 ----------
# ⚠️ 隐私提示：启用 LLM 后，**提交的代码会被发送到所配置的第三方服务商**。
#    本项目的规则、特征提取与 Semgrep 都在本机完成；只有 LLM 这一路会出网。
#    不希望代码离开本机时，请保持 LLM_ENABLED=false 且不要在请求里启用 enable_llm。
#
# 是否启用 LLM 分析器（总开关）。
# false 时即使请求里 enable_llm=true 也不会发起模型调用；其余功能不受影响。
# 缺少 API key / 地址 / 模型名时，LLM 报 unavailable，规则分析照常工作。
LLM_ENABLED=false

# OpenAI-compatible API 的服务地址，需包含版本路径。
# 示例（仅作格式示意，请以你实际使用的服务商文档为准）：
#   https://api.example.com/v1
LLM_BASE_URL=

# 真实密钥只填写在上一步复制出的 .env 中。
# 本文件必须保持为空。
LLM_API_KEY=

# 模型名称，例如（仅示例）：gpt-4o-mini / qwen-plus / deepseek-chat
LLM_MODEL=

# 单次请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 单次请求最大输出 token，用于限制响应长度
LLM_MAX_OUTPUT_TOKENS=2048
# 有限重试次数（只对 429 / 5xx / 超时 / 网络错误生效），不得设置得过大
LLM_MAX_RETRIES=2
# 发送给模型的代码字符上限（含行号前缀）。超长代码按行截断，
# 并在提示词中写明"共多少行、本次提供到第几行"。
LLM_MAX_INPUT_CHARS=12000

# ---------- 可选静态分析器：Semgrep ----------
# 是否启用由**请求参数** analysis_options.enable_semgrep 决定，没有全局开关。
# Semgrep 未安装时，启用它只会得到 unavailable 状态，其余分析器照常工作。
#
# 可执行文件名或完整路径；默认从 PATH 查找，找不到时会再试当前虚拟环境的目录。
# 只能填可执行文件名/路径——规则集固定为仓库内置的那一份，不接受额外参数。
SEMGREP_COMMAND=semgrep
# 单次扫描的子进程超时（秒），须大于 0、不超过 300
SEMGREP_TIMEOUT_SECONDS=30
#
# 遥测与版本检查由程序强制关闭（--metrics=off --disable-version-check），
# 并会从子进程环境中删除 SEMGREP_APP_TOKEN，无需在此配置。

# ---------- 本地扫描历史 ----------
# SQLite 数据库文件路径，留空表示使用默认的本地路径；该文件已被 .gitignore 忽略
HISTORY_DB_PATH=
# 是否启用扫描历史功能
HISTORY_ENABLED=false

# ============================================================
# 提示：调用第三方 LLM 服务会把待分析的代码发送到所配置的服务商。
# 如不希望代码离开本机，请保持 LLM_ENABLED=false。
# ============================================================
